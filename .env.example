# Keep all credentials on the server. Never use NEXT_PUBLIC_ for these values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Local development defaults to file:./data/launchready.db.
# Vercel requires a persistent hosted database:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional exact origin; otherwise the incoming request origin is used.
APP_ORIGIN=
